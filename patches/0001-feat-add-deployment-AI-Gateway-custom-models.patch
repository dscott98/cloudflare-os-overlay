+import { useState } from 'react'
+import { Button, Input, useKumoToastManager } from '@cloudflare/kumo'
+import { RpcStub } from 'capnweb'
+import {
+  AdminAiGatewayCustomModel,
+  AdminAiGatewayCustomModelInput,
+  AdminApi,
+} from '@gadgets/workshop-shared/api'
+
+type Draft = AdminAiGatewayCustomModelInput
+
+const EMPTY_DRAFT: Draft = {
+  displayName: '',
+  providerSlug: '',
+  modelId: '',
+  chatCompletionsPath: 'v1/chat/completions',
+}
+
+/** Deployment-wide AI Gateway custom-provider model catalog editor. */
+export default function AiGatewayCustomModelsPanel({
+  admin,
+  models,
+  onChanged,
+}: {
+  admin: RpcStub<AdminApi>
+  models: AdminAiGatewayCustomModel[]
+  onChanged: () => Promise<void>
+}) {
+  const toasts = useKumoToastManager()
+  const [editingId, setEditingId] = useState<string | null>(null)
+  const [draft, setDraft] = useState<Draft>(EMPTY_DRAFT)
+  const [busy, setBusy] = useState(false)
+  const [deletingId, setDeletingId] = useState<string | null>(null)
+
+  const update = <K extends keyof Draft>(key: K, value: Draft[K]) => {
+    setDraft((current) => ({ ...current, [key]: value }))
+  }
+
+  const reset = () => {
+    setEditingId(null)
+    setDraft(EMPTY_DRAFT)
+  }
+
+  const save = async () => {
+    setBusy(true)
+    try {
+      if (editingId) await admin.updateAiGatewayCustomModel(editingId, draft)
+      else await admin.createAiGatewayCustomModel(draft)
+      await onChanged()
+      reset()
+      toasts.add({ title: editingId ? 'Model updated' : 'Model added', variant: 'success' })
+    } catch (err) {
+      toasts.add({
+        title: err instanceof Error ? err.message : 'Could not save custom model',
+        variant: 'error',
+      })
+    } finally {
+      setBusy(false)
+    }
+  }
+
+  const remove = async (model: AdminAiGatewayCustomModel) => {
+    if (!confirm(`Remove deployment model "${model.displayName}"? Existing chats using it will no longer run.`)) return
+    setDeletingId(model.id)
+    try {
+      await admin.deleteAiGatewayCustomModel(model.id)
+      await onChanged()
+      if (editingId === model.id) reset()
+      toasts.add({ title: 'Model removed', variant: 'success' })
+    } catch (err) {
+      toasts.add({
+        title: err instanceof Error ? err.message : 'Could not remove custom model',
+        variant: 'error',
+      })
+    } finally {
+      setDeletingId(null)
+    }
+  }
+
+  return (
+    <div className="space-y-5">
+      <div className="bg-kumo-elevated border border-kumo-line rounded-xl p-6">
+        <h2 className="text-lg font-semibold text-kumo-strong mb-1">AI Gateway custom models</h2>
+        <p className="text-sm text-kumo-subtle mb-5">
+          Make a model from an already-configured AI Gateway custom provider available to everyone.
+          Provider credentials stay in AI Gateway and are never entered here.
+        </p>
+
+        <div className="grid gap-4 sm:grid-cols-2">
+          <label className="space-y-1.5 text-sm text-kumo-default">
+            Display name
+            <Input value={draft.displayName} onChange={(event) => update('displayName', event.target.value)} placeholder="My coding model" />
+          </label>
+          <label className="space-y-1.5 text-sm text-kumo-default">
+            Provider slug
+            <Input value={draft.providerSlug} onChange={(event) => update('providerSlug', event.target.value)} placeholder="my-provider" />
+          </label>
+          <label className="space-y-1.5 text-sm text-kumo-default">
+            Model ID
+            <Input value={draft.modelId} onChange={(event) => update('modelId', event.target.value)} placeholder="my-model" />
+          </label>
+          <label className="space-y-1.5 text-sm text-kumo-default">
+            Chat Completions path
+            <Input value={draft.chatCompletionsPath} onChange={(event) => update('chatCompletionsPath', event.target.value)} placeholder="v1/chat/completions" />
+          </label>
+        </div>
+        <p className="mt-3 text-xs text-kumo-subtle">
+          Enter the upstream relative Chat Completions path, such as <code>v1/chat/completions</code> or <code>v4/chat/completions</code>.
+        </p>
+        <div className="mt-5 flex justify-end gap-2">
+          {editingId && <Button variant="ghost" size="sm" onClick={reset} disabled={busy}>Cancel</Button>}
+          <Button variant="primary" size="sm" onClick={save} loading={busy}>
+            {editingId ? 'Save model' : 'Add model'}
+          </Button>
+        </div>
+      </div>
+
+      <div className="bg-kumo-elevated border border-kumo-line rounded-xl divide-y divide-kumo-line">
+        {models.length === 0 ? (
+          <p className="p-6 text-sm text-kumo-subtle">No deployment custom models configured.</p>
+        ) : models.map((model) => (
+          <div key={model.id} className="flex flex-wrap items-center gap-3 p-4">
+            <div className="min-w-0 flex-1">
+              <p className="truncate text-sm font-medium text-kumo-default">{model.displayName}</p>
+              <p className="mt-0.5 truncate font-mono text-xs text-kumo-subtle">
+                {model.providerSlug} / {model.modelId} · {model.chatCompletionsPath}
+              </p>
+            </div>
+            <Button variant="ghost" size="sm" disabled={busy || deletingId === model.id} onClick={() => {
+              setEditingId(model.id)
+              setDraft({
+                displayName: model.displayName,
+                providerSlug: model.providerSlug,
+                modelId: model.modelId,
+                chatCompletionsPath: model.chatCompletionsPath,
+              })
+            }}>Edit</Button>
+            <Button variant="ghost" size="sm" disabled={busy || deletingId === model.id} loading={deletingId === model.id} onClick={() => remove(model)}>Remove</Button>
+          </div>
+        ))}
+      </div>
+    </div>
+  )
+}
