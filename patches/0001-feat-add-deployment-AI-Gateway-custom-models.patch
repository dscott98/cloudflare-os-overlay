+
+/** Whether an ID belongs to Workshop's reserved deployment-model namespace. */
+export function isAiGatewayCustomModelId(id: string): boolean {
+  return id.startsWith(AI_GATEWAY_CUSTOM_MODEL_ID_PREFIX);
