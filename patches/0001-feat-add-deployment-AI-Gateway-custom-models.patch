+
+// Validate the persisted/admin-supplied entry. This returns a normalized copy rather than mutating
+// the input so the parser can safely drop malformed legacy entries.
+export function normalizeAiGatewayCustomModel(value: unknown): AdminAiGatewayCustomModel | undefined {
+  if (!value || typeof value !== "object") return undefined;
+  let {id, displayName, providerSlug, modelId, chatCompletionsPath} =
+      value as Partial<AdminAiGatewayCustomModel>;
+  if (typeof id !== "string" || !CUSTOM_MODEL_ID.test(id) ||
+      typeof displayName !== "string" || typeof providerSlug !== "string" ||
+      typeof modelId !== "string" || typeof chatCompletionsPath !== "string") {
+    return undefined;
+  }
+  displayName = displayName.trim();
+  providerSlug = providerSlug.trim();
+  modelId = modelId.trim();
+  chatCompletionsPath = chatCompletionsPath.trim();
+  if (!displayName || displayName.length > MAX_CUSTOM_MODEL_DISPLAY_NAME ||
+      !providerSlug || providerSlug.length > MAX_CUSTOM_MODEL_SLUG ||
+      !CUSTOM_PROVIDER_SLUG.test(providerSlug) || !modelId || modelId.length > MAX_CUSTOM_MODEL_ID ||
+      chatCompletionsPath.length > MAX_CUSTOM_MODEL_PATH || hasControlCharacters(displayName) ||
+      hasControlCharacters(modelId) || !isSafeChatCompletionsPath(chatCompletionsPath)) {
+    return undefined;
+  }
+  return {id, displayName, providerSlug, modelId, chatCompletionsPath};
+}
+
+/** Normalize a custom-model input or throw an error appropriate for the admin UI. */
+export function requireAiGatewayCustomModelInput(
+    input: Omit<AdminAiGatewayCustomModel, "id">): Omit<AdminAiGatewayCustomModel, "id"> {
+  let entry = normalizeAiGatewayCustomModel({id: `${AI_GATEWAY_CUSTOM_MODEL_ID_PREFIX}` +
+      "00000000-0000-0000-0000-000000000000", ...input});
+  if (!entry) {
+    throw new Error("Invalid custom model name, provider slug, model ID, or Chat Completions path.");
+  }
+  return {
+    displayName: entry.displayName,
+    providerSlug: entry.providerSlug,
+    modelId: entry.modelId,
+    chatCompletionsPath: entry.chatCompletionsPath,
+  };
+}
+
+function hasControlCharacters(value: string): boolean {
+  for (let index = 0; index < value.length; ++index) {
+    let code = value.charCodeAt(index);
+    if (code <= 0x1f || code === 0x7f) return true;
+  }
+  return false;
+}
+
+function isSafeChatCompletionsPath(path: string): boolean {
+  if (path.startsWith("/") || path.includes("?") || path.includes("#") || path.includes("%") ||
+      hasControlCharacters(path)) return false;
+  let segments = path.split("/");
+  return segments.length >= 2 && segments.every(segment => SAFE_PATH_SEGMENT.test(segment)) &&
+      segments.at(-2) === "chat" && segments.at(-1) === "completions";
+}
+
+function parseAiGatewayCustomModels(value: unknown): AdminAiGatewayCustomModel[] {
+  if (!Array.isArray(value)) return [];
+  let entries: AdminAiGatewayCustomModel[] = [];
+  let ids = new Set<string>();
+  let routes = new Set<string>();
+  for (let rawEntry of value) {
+    let entry = normalizeAiGatewayCustomModel(rawEntry);
+    if (!entry || ids.has(entry.id)) continue;
+    let route = `${entry.providerSlug}\u0000${entry.modelId}\u0000${entry.chatCompletionsPath}`;
+    if (routes.has(route)) continue;
+    ids.add(entry.id);
+    routes.add(route);
+    entries.push(entry);
+  }
+  return entries;
+}
