+  #requireAiGateway(): void {
+    if (!getAiGatewayConfig(this.env)) {
+      throw new Error("A deployment AI Gateway must be configured before adding custom models.");
+    }
+  }
+
+  async createAiGatewayCustomModel(input: AdminAiGatewayCustomModelInput): Promise<void> {
+    this.#requireAiGateway();
+    let fields = requireAiGatewayCustomModelInput(input);
+    let entry: AdminAiGatewayCustomModel = {id: `aig-custom:${crypto.randomUUID()}`, ...fields};
+    await this.#mutateAdminConfig(config => {
+      if (config.aiGatewayCustomModels.some(model =>
+          model.id === entry.id || sameCustomModelRoute(model, entry))) {
+        throw new Error("A custom model with that provider, model ID, and endpoint path already exists.");
+      }
+      return {...config, aiGatewayCustomModels: [...config.aiGatewayCustomModels, entry]};
+    });
+  }
+
+  async updateAiGatewayCustomModel(id: string, input: AdminAiGatewayCustomModelInput): Promise<void> {
+    this.#requireAiGateway();
+    if (!isAiGatewayCustomModelId(id)) throw new Error("Custom model not found.");
+    let fields = requireAiGatewayCustomModelInput(input);
+    await this.#mutateAdminConfig(config => {
+      let index = config.aiGatewayCustomModels.findIndex(model => model.id === id);
+      if (index < 0) throw new Error("Custom model not found.");
+      let replacement: AdminAiGatewayCustomModel = {id, ...fields};
+      if (config.aiGatewayCustomModels.some((model, candidate) =>
+          candidate !== index && sameCustomModelRoute(model, replacement))) {
+        throw new Error("A custom model with that provider, model ID, and endpoint path already exists.");
+      }
+      let aiGatewayCustomModels = [...config.aiGatewayCustomModels];
+      aiGatewayCustomModels[index] = replacement;
+      return {...config, aiGatewayCustomModels};
+    });
+  }
+
+  async deleteAiGatewayCustomModel(id: string): Promise<void> {
+    if (!isAiGatewayCustomModelId(id)) throw new Error("Custom model not found.");
+    await this.#mutateAdminConfig(config => {
+      let aiGatewayCustomModels = config.aiGatewayCustomModels.filter(model => model.id !== id);
+      if (aiGatewayCustomModels.length === config.aiGatewayCustomModels.length) {
+        throw new Error("Custom model not found.");
+      }
+      return {...config, aiGatewayCustomModels};
+    });
+  }
