From 835d03ca37bdb4956359eea17aa1dc51f2d4700a Mon Sep 17 00:00:00 2001
From: Dustin Scott <dscott98@gmail.com>
Date: Thu, 13 Aug 2026 21:02:30 -0700
Subject: [PATCH] fix: hide deployment model editor without gateway

Only deployments with an AI Gateway can create deployment-managed models. Keep the editor out of the provider page until that configuration is enabled, rather than presenting administrators with a form whose backend mutation must fail. This belongs in the frontend route because AI Gateway configuration is deployment runtime state, not a Blueprint or Gatekeeper capability.
---
 packages/workshop-frontend/src/routes/providers.tsx | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/packages/workshop-frontend/src/routes/providers.tsx b/packages/workshop-frontend/src/routes/providers.tsx
index 750817d..0746838 100644
--- a/packages/workshop-frontend/src/routes/providers.tsx
+++ b/packages/workshop-frontend/src/routes/providers.tsx
@@ -315,7 +315,7 @@ function ProvidersPage() {
           </div>
         )}
 
-        {admin && (
+        {gatewayMode && admin && (
           <div className="px-3 pb-4">
             <AiGatewayCustomModelsPanel
               admin={admin.api}
-- 
